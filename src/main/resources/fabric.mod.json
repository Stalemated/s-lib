{
    "schemaVersion": 1,
    "id": "s_lib",
    "version": "${version}",
    "name": "S-Lib",
    "description": "An easy to use general utility and config library.",
    "authors": [
        "Stalemated"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/s-lib",
        "sources": "https://github.com/Stalemated/s-lib",
        "issues": "https://github.com/Stalemated/s-lib/issues"
    },
    "license": "MIT",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.stalemated.lib.SLib"
        ],
        "client": [
            "com.stalemated.lib.client.SLibClient"
        ]
    },
    "mixins": [
        "s-lib.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft}",
        "java": ">=${java_version}",
        "fabric-api": "*"
    }
}
