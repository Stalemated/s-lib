{
    "schemaVersion": 1,
    "id": "s_lib",
    "version": "${version}",
    "name": "S-Lib",
    "description": "A core utility library providing shared code for Stalemated's mods.",
    "authors": [
        "Stalemated"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/s-lib",
        "sources": "https://github.com/Stalemated/s-lib",
        "issues": "https://github.com/Stalemated/s-lib/issues"
    },
    "license": "MIT",
    "icon": "icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.stalemated.lib.fabric.SLibFabricClient"
        ]
    },
    "mixins": [
        "s-lib.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.2",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    }
}
