{
    "schemaVersion": 1,
    "id": "stalelib",
    "version": "${version}",
    "name": "StaleLib",
    "description": "Client-side library with shared code across my mods.",
    "authors": [
        "Stalemated"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/stalelib",
        "sources": "https://github.com/Stalemated/stalelib",
        "issues": "https://github.com/Stalemated/stalelib/issues"
    },
    "license": "MIT",
    "icon": "icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.stalemated.lib.fabric.StaleLibFabricClient"
        ]
    },
    "mixins": [
        "stalelib.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.10",
        "minecraft": "~1.20.1",
        "java": ">=17",
        "fabric-api": "*",
        "yet_another_config_lib_v3": ">=3.6.2"
    },
    "suggests": {
        "another-mod": "*"
    }
}
